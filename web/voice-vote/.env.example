VOICE_VOTE_WEB_IMAGE=talkinghead-vote-web:local
VOICE_VOTE_IMAGE=talkinghead-vote-server:local
VOICE_VOTE_WEB_PORT=8080
VOICE_VOTE_CATALOGUE_DIR=/srv/talkinghead/catalogue
VOICE_VOTE_LIBRARIES_DIR=/srv/talkinghead/libraries
VOICE_VOTE_ADMIN_PASSWORD_FILE=/srv/talkinghead/secrets/admin-password.txt
# Production requires an HTTPS reverse proxy. False is for local HTTP only.
VOICE_VOTE_SECURE_COOKIE=true
# Enable after importing a complete verified model cache.
VOICE_VOTE_MODEL_OFFLINE=true
